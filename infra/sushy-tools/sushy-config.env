# Sushy-tools configuration for virtual BMC nodes
# This file configures sushy-tools to emulate Redfish/BMC endpoints

# Libvirt connection URI
SUSHY_TOOLS_LIBVIRT_URI=qemu:///system

# Enable SSL (disabled for lab - BMCs often reject self-signed certs)
SUSHY_TOOLS_ENABLE_SSL=False

# Listen on all interfaces within the VM
SUSHY_TOOLS_LISTEN_IP=0.0.0.0

# Redfish API port
SUSHY_TOOLS_LISTEN_PORT=8001

# Virtual BMC nodes to create (3-5 nodes)
# Each node gets a unique UUID and MAC address
SUSHY_TOOLS_VM_NODES=5

# Node configuration template
# UUIDs are generated, MACs are sequential for predictability
SUSHY_TOOLS_NODE_TEMPLATE=shoal-node-

# Authentication for virtual BMCs
SUSHY_TOOLS_USERNAME=admin
SUSHY_TOOLS_PASSWORD=password

# Enable verbose logging for debugging
SUSHY_TOOLS_DEBUG=True

# Serial console socket directory (for SOL test harness)
SUSHY_TOOLS_SERIAL_SOCKET_DIR=/var/run/libvirt/qemu
