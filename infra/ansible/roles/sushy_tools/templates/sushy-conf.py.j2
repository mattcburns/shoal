# Sushy-tools emulator configuration
# This is a Python config file loaded by sushy-emulator. Variable names must
# start with SUSHY_EMULATOR_.

# Network binding
SUSHY_EMULATOR_LISTEN_IP = "0.0.0.0"
SUSHY_EMULATOR_LISTEN_PORT = {{ shoal_sushy_port }}

# TLS is disabled in the lab (MVP uses plain HTTP)
SUSHY_EMULATOR_SSL_CERT = None
SUSHY_EMULATOR_SSL_KEY = None

# Authentication
SUSHY_EMULATOR_AUTH_FILE = "/root/sushy/auth.htpasswd"

# Libvirt connection for the nested lab VMs
SUSHY_EMULATOR_LIBVIRT_URI = "qemu:///system"

# Feature set
SUSHY_EMULATOR_FEATURE_SET = "full"

# Storage pool for virtual media attachments
SUSHY_EMULATOR_STORAGE_POOL = "default"
